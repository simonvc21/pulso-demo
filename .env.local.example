# Supabase — Pulso project (us-west-2)
# Single vendor for DB + Auth (no Clerk).
# These keys are SAFE to commit — publishable / anon keys are designed for client code.

NEXT_PUBLIC_SUPABASE_URL=https://wmsmptedodmtmtrdnaud.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_3h1B0Wp8o7yeSIoJZpIQSA_pP6iFN18

# Service role — NEVER commit, never ship to client.
# Pull from Supabase dashboard → Project Settings → API,
# then add it as a Vercel Environment Variable (production+preview, NOT NEXT_PUBLIC_).
# SUPABASE_SERVICE_ROLE_KEY=

# Google OAuth — optional, configure in Supabase Dashboard → Auth → Providers → Google.
# Requires creating an OAuth 2.0 Client in Google Cloud Console (10 min).
# Authorized redirect URI to whitelist:
#   https://wmsmptedodmtmtrdnaud.supabase.co/auth/v1/callback

# Resend — email delivery (form invites, reminders, newsletter notifications)
# Free tier: 3K emails/mo. Paid: $20/mo for 50K.
# Get your API key at https://resend.com/api-keys
# Server-only (never NEXT_PUBLIC_).
RESEND_API_KEY=

# The "From" address for outgoing emails. Must be a domain you've verified in
# Resend. Default Resend sandbox: onboarding@resend.dev (works only for the
# email of your Resend account; use to test before verifying your domain).
# Once verified: forms@your-fund.com or notifications@pulso.vc
EMAIL_FROM=onboarding@resend.dev
EMAIL_FROM_NAME=Pulso
